# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

# ----- Temporales / sistema -----
*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

/.sourcemaps
/.versions
/coverage

# ----- Ionic -----
/.ionic
/www
/platforms
/plugins

# ----- Compilados / salida -----
/dist
/tmp
/out-tsc
/bazel-out

# ----- Node -----
/node_modules

# ----- Capacitor (builds nativos) -----
# Si añades plataformas (npx cap add android / ios), estas carpetas las
# regenera Capacitor; los artefactos de build NO deben subirse.
/android/app/build
/android/build
/android/.gradle
/android/local.properties
/android/captures
/android/.idea
/ios/App/build
/ios/App/Pods
/ios/App/output
/ios/DerivedData
/ios/Podfile.lock

# ----- Variables de entorno y secretos -----
.env
.env.*
!.env.example
*.pem
*.key

# ----- IDEs y editores -----
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-project
*.sublime-workspace

# Visual Studio Code: deja sólo configuración compartida útil
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# ----- Caches varias -----
/.angular
/.angular/cache
.sass-cache/
/.nx
/.nx/cache
/connect.lock
/libpeerconnection.log
testem.log
/typings
.eslintcache
.stylelintcache

# ----- Archivos de sistema operativo -----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
